{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Play Dolphin Drift",
      "program": "${workspaceFolder}/server.mjs",
      "console": "internalConsole",
      "serverReadyAction": {
        "pattern": "ready at (https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
